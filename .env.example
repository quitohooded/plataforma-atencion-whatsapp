# Copiar este archivo como .env y completar los valores.
# Ninguna variable es obligatoria para correr el prototipo en modo local con el simulador.

# --- Aplicación ---
# Clave para firmar las sesiones del panel. Si se deja comentada, la aplicación genera una
# aleatoria la primera vez y la guarda en instance/clave_secreta.txt.
# SECRET_KEY=
# Nombre que se muestra en el panel y en los mensajes del bot.
PLATAFORMA_NOMBRE=Respondé
# Base de datos SQLite (ruta relativa a la carpeta instance/ si se deja vacío).
# DATABASE_URL=sqlite:///C:/ruta/a/plataforma.db
# Registro anticipado de SQLite (WAL): mejor concurrencia. Poner false si la base está en un disco de red.
SQLITE_WAL=true
ZONA_HORARIA=America/Argentina/Cordoba
# Horas sin actividad tras las cuales una conversación se cierra.
CONVERSACION_HORAS_INACTIVIDAD=24
# Simulador de WhatsApp para demos (/simulador). Desactivar en un despliegue real.
SIMULADOR_HABILITADO=true
# Poner en true si la app corre detrás de un túnel o proxy (cloudflared, ngrok, PythonAnywhere):
# así se usa la IP real del visitante en los límites de intentos y se reconoce el HTTPS.
CONFIAR_EN_PROXY=false
# Cookies solo por HTTPS. Si se deja vacío, se activa cuando URL_PUBLICA empieza con https.
# COOKIES_SEGURAS=true
# Límite de intentos por IP en ingreso, registro, recuperación de contraseña y simulador.
LIMITES_POR_IP=true
# Cola de tareas en segundo plano (asincronismo y resiliencia en VM de 1 GB).
# false: responde 200 a Meta en <30 ms y procesa mensajes en segundo plano (producción).
# true: procesa de manera sincrónica en el mismo hilo (desarrollo local y pruebas).
# COLA_SINCRONICA=false

# --- WhatsApp Business Platform (Cloud API) ---
# Datos que entrega Meta en developers.facebook.com > App > WhatsApp > Configuración de la API.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Texto libre que se carga también en la configuración del webhook de Meta.
WHATSAPP_VERIFY_TOKEN=un-texto-secreto-para-verificar-el-webhook
# Clave secreta de la app (Configuración de la app > Básica). Se usa para validar la firma del webhook:
# sin ella el webhook rechaza todos los eventos.
WHATSAPP_APP_SECRET=
# Solo para probar el webhook en local sin la clave de Meta. Nunca en un despliegue real.
# WHATSAPP_PERMITIR_SIN_FIRMA=false
WHATSAPP_API_VERSION=v23.0
# Número público de la línea, solo dígitos con código de país (se usa para armar el enlace wa.me).
WHATSAPP_NUMERO_PUBLICO=
# Los números argentinos llegan como 549XXXXXXXXXX; la API los acepta sin el 9 en modo de prueba.
WHATSAPP_AR_QUITAR_9=true

# --- Meta Embedded Signup (Onboarding de WhatsApp Oficial en 1-Clic - Pilar 2) ---
# Identificador de la aplicación en Meta for Developers (developers.facebook.com).
# META_APP_ID=
# Configuration ID creado en WhatsApp > Embedded Signup en el panel de Meta.
# META_CONFIG_ID=
# Token de usuario del sistema de la app con permisos whatsapp_business_management y whatsapp_business_messaging
# para suscribir webhooks y gestionar WABAs automáticamente.
# META_SYSTEM_USER_TOKEN=

# --- Correo (avisos de consultas pendientes y recuperación de contraseña) ---
# Dirección pública del panel, para los enlaces de los correos.
# URL_PUBLICA=https://mi-plataforma.example
# archivo: los correos se guardan en instance/correos (sin costo, para desarrollo y demos).
# smtp: se envían con el servidor de abajo. desactivado: no se envían.
MAIL_MODO=archivo
# Ejemplo sin costo con Gmail: smtp.gmail.com, puerto 587 y una contraseña de aplicación.
# MAIL_SERVIDOR=smtp.gmail.com
# MAIL_PUERTO=587
# MAIL_USUARIO=
# MAIL_CONTRASENA=
# MAIL_REMITENTE=Respondé <avisos@ejemplo.com>
# MAIL_TLS=true
# Como máximo un aviso de pendientes por correo cada tantos minutos.
AVISOS_CORREO_MINUTOS=30

# --- Datos personales ---
# Días que se guardan los mensajes y las consultas (las pendientes se conservan). 0: sin límite.
RETENCION_DIAS=365
# La depuración corre sola una vez por día. También: flask --app app admin depurar
DEPURACION_AUTOMATICA=true
# Correo de quien opera la plataforma, para la política de privacidad y los términos de uso.
# CONTACTO_PLATAFORMA=privacidad@ejemplo.com

# --- Inteligencia Artificial (Google Gemini Interactions API) ---
# Clave de API de Google Gemini (opcional en desarrollo; el sistema incluye extractor local de respaldo).
# GEMINI_API_KEY=
# Modelos para chat comprador y asistente interno del panel (May 2026+).
# GEMINI_MODEL_CHAT=gemini-3.5-flash-lite
# GEMINI_MODEL_INTERNO=gemini-3.8-flash

# --- Mercado Pago (Monetización Real y Billetera Prepaga) ---
# Credenciales de Mercado Pago obtenidas en developers.mercadopago.com
# Si se dejan vacías, la plataforma opera en modo de simulación segura para pruebas locales sin credenciales.
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
# MERCADOPAGO_PUBLIC_KEY=APP_USR-...
# MERCADOPAGO_WEBHOOK_SECRET=
PLAN_PRO_PRECIO_MENSUAL=14900

# --- Despliegue con Docker + Caddy (docker-compose.yml) ---
# Dominio público que apunta a la IP del servidor (por ejemplo, miapp.duckdns.org) y correo
# para los avisos de vencimiento de Let's Encrypt. En una VM real, activar también:
# SECRET_KEY (64+ caracteres), URL_PUBLICA=https://DOMINIO, CONFIAR_EN_PROXY=true,
# SQLITE_WAL=true, MAIL_MODO=smtp y SIMULADOR_HABILITADO=false.
# DOMINIO=miapp.duckdns.org
# ACME_EMAIL=avisos@ejemplo.com
# Destino opcional de rclone para copiar los respaldos diarios fuera de la VM (deploy/respaldar.sh).
# RCLONE_REMOTO=gdrive:responde-respaldos

